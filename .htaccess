# Block .env (credentials); also blocked globally in Apache security.conf
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

# Deny sensitive root files (repo is often served above public/)
<FilesMatch "(?i)^(docker-compose(?:\.envfile)?\.ya?ml|Dockerfile|\.dockerignore|check-db\.php|composer\.(?:json|lock)|\.env\.example)$">
    Require all denied
</FilesMatch>

# Block direct HTTP access to sensitive directories when doc root is the project root
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /webhooks/
    # App lives in public/; avoid 403 on bare /webhooks/ (no index file at repo root)
    RewriteRule ^$ public/ [L,R=301]
    RewriteRule ^\.git(/|$) - [F,L]
    RewriteRule ^(?:data|config|src|templates|scripts)(/|$) - [F,L]
</IfModule>
